🧑‍💻 Python Program
def count_unique_digits(n):
    if n == 0:
        return 1
    if n > 10:
        n = 10  # only 10 unique digits (0–9)

    result = 10  # All 1-digit numbers
    product = 9
    available = 9

    for i in range(2, n + 1):
        product *= available
        result += product
        available -= 1

    return result

# Example usage
print("Unique-digit numbers up to 2 digits:", count_unique_digits(2))  # Output: 91

