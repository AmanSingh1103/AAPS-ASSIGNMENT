Python Program (Backtracking Approach):
def generate_subsets(nums):
    result = []

    # Helper function to generate subsets using backtracking
    def backtrack(start, current_subset):
        result.append(current_subset[:])  # Add a copy of current_subset to the result
        for i in range(start, len(nums)):
            current_subset.append(nums[i])
            backtrack(i + 1, current_subset)  # Recur for next elements
            current_subset.pop()  # Backtrack, remove last element
    
    # Start the backtracking process
    backtrack(0, [])
    return result

# Example usage
nums = [1, 2, 3]
print("All subsets are:", generate_subsets(nums))
